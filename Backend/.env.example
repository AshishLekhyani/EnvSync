DATABASE_URL="postgresql://envsync_dev:devpassword@localhost:5432/envsync_dev?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ENCRYPTION_MASTER_KEY=base64:replace-with-32-random-bytes-base64-encoded
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# OAuth (optional — GitHub/Google login buttons are disabled gracefully if unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — password reset, invites, and email verification fall back to
# showing the link directly in the UI instead of emailing it when this is unset)
#
# Gmail: enable 2-Step Verification on the account, then create an App Password
#   at https://myaccount.google.com/apppasswords — use that, not the account password.
# Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false,
#   also needs an app password if the account has 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EnvSync <you@gmail.com>"
