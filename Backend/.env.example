DATABASE_URL="postgresql://envsync_dev:devpassword@localhost:5432/envsync_dev?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ENCRYPTION_MASTER_KEY=base64:replace-with-32-random-bytes-base64-encoded
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# OAuth (optional — the Google login button is disabled gracefully if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional — password reset, invites, and email verification fall back to
# showing the link directly in the UI instead of emailing it when this is unset)
#
# Sent via SendGrid's HTTP API (not raw SMTP — many hosts, including Render,
# block outbound SMTP ports). Create a free SendGrid account, verify a single
# sender email under Settings -> Sender Authentication -> Single Sender
# Verification (no domain required), then create a restricted API key with
# only "Mail Send" permission at Settings -> API Keys.
SENDGRID_API_KEY=
EMAIL_FROM="EnvSync <you@example.com>"
