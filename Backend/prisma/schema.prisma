generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  PASSWORD
  GITHUB
  GOOGLE
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  avatarUrl         String?      @db.Text
  notificationPrefs Json?
  authProvider      AuthProvider @default(GOOGLE)
  providerId        String?
  emailVerifiedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  memberships                     OrgMembership[]
  membershipsInvited              OrgMembership[]                @relation("MembershipInviter")
  sessions                        Session[]
  auditLogs                       AuditLog[]                     @relation("ActorUser")
  secretVersionsAuthored          SecretVersion[]                @relation("SecretVersionAuthor")
  apiTokensCreated                ApiToken[]                     @relation("ApiTokenCreator")
  notifications                   Notification[]                 @relation("NotificationRecipient")
  invitesSent                     OrgInvite[]                    @relation("InviteInviter")
  invitesAccepted                 OrgInvite[]                    @relation("InviteAcceptor")
  invitesApproved                 OrgInvite[]                    @relation("InviteApprover")
  projectAccess                   ProjectMembership[]            @relation("ProjectMember")
  projectAccessGranted            ProjectMembership[]            @relation("ProjectAccessGrantor")
  autoApproveRulesAsInviter       InviteAutoApproveRule[]        @relation("AutoApproveInviter")
  autoApproveRulesCreated         InviteAutoApproveRule[]        @relation("AutoApproveCreatedBy")
  projectAccessRequested          ProjectAccessRequest[]         @relation("ProjectAccessRequester")
  projectAccessDecided            ProjectAccessRequest[]         @relation("ProjectAccessDecider")
  roleChangeRequested             RoleChangeRequest[]            @relation("RoleChangeRequester")
  roleChangeDecided               RoleChangeRequest[]            @relation("RoleChangeDecider")
  projectCreationRequested        ProjectCreationRequest[]       @relation("ProjectCreationRequester")
  projectCreationDecided          ProjectCreationRequest[]       @relation("ProjectCreationDecider")
  projectCreateAutoApproveAsAdmin ProjectCreateAutoApproveRule[] @relation("ProjectCreateAutoApproveAdmin")
  projectCreateAutoApproveCreated ProjectCreateAutoApproveRule[] @relation("ProjectCreateAutoApproveCreatedBy")

  @@unique([authProvider, providerId])
}

enum OrgRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                   OrgMembership[]
  projects                      Project[]
  encryptionKey                 OrgEncryptionKey?
  auditLogs                     AuditLog[]
  apiTokens                     ApiToken[]
  notifications                 Notification[]
  invites                       OrgInvite[]
  permissionOverrides           OrgEnvironmentPermission[]
  inviteAutoApproveRules        InviteAutoApproveRule[]
  projectAccessRequests         ProjectAccessRequest[]
  roleChangeRequests            RoleChangeRequest[]
  projectCreationRequests       ProjectCreationRequest[]
  projectCreateAutoApproveRules ProjectCreateAutoApproveRule[]
}

model OrgMembership {
  id                 String   @id @default(cuid())
  userId             String
  orgId              String
  role               OrgRole  @default(VIEWER)
  canViewAllProjects Boolean  @default(false)
  invitedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org            Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  environments   Environment[]
  auditLogs      AuditLog[]
  memberships    ProjectMembership[]
  invites        OrgInvite[]
  accessRequests ProjectAccessRequest[]

  @@unique([orgId, slug])
}

model ProjectMembership {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  role        OrgRole  @default(VIEWER)
  grantedById String
  createdAt   DateTime @default(now())

  user      User    @relation("ProjectMember", fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("ProjectAccessGrantor", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
}

enum ProjectCreationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectCreationRequest {
  id            String                @id @default(cuid())
  orgId         String
  name          String
  slug          String
  description   String?
  requestedById String
  status        ProjectCreationStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("ProjectCreationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?        @relation("ProjectCreationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model ProjectCreateAutoApproveRule {
  id          String   @id @default(cuid())
  orgId       String
  adminId     String
  createdById String
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  admin     User         @relation("ProjectCreateAutoApproveAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  createdBy User         @relation("ProjectCreateAutoApproveCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([orgId, adminId])
  @@index([orgId])
}

enum EnvironmentType {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

model Environment {
  id        String          @id @default(cuid())
  projectId String
  type      EnvironmentType
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  secrets Secret[]

  @@unique([projectId, type])
}

model Secret {
  id            String @id @default(cuid())
  environmentId String
  key           String

  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  currentVersion Int       @default(1)
  expiresAt      DateTime?
  deletedAt      DateTime?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environment Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  versions    SecretVersion[]

  @@unique([environmentId, key])
  @@index([deletedAt])
}

enum SecretChangeType {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ROTATE
}

model SecretVersion {
  id          String           @id @default(cuid())
  secretId    String
  version     Int
  ciphertext  Bytes
  iv          Bytes
  authTag     Bytes
  changeType  SecretChangeType
  createdById String?
  createdAt   DateTime         @default(now())

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  author User?  @relation("SecretVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([secretId, version])
}

model OrgEncryptionKey {
  id         String   @id @default(cuid())
  orgId      String   @unique
  wrappedDek Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  projectId  String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor   User?         @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  tokenHash   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation("ApiTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Notification {
  id          String   @id @default(cuid())
  orgId       String
  recipientId String
  type        String
  message     String
  targetType  String?
  targetId    String?
  metadata    Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipient User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
  @@index([orgId, type, targetId])
}

enum EnvironmentAccessLevel {
  NONE
  READ
  WRITE
}

model OrgEnvironmentPermission {
  id              String                 @id @default(cuid())
  orgId           String
  role            OrgRole
  environmentType EnvironmentType
  access          EnvironmentAccessLevel
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role, environmentType])
  @@index([orgId])
}

enum InviteApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model OrgInvite {
  id             String               @id @default(cuid())
  orgId          String
  email          String
  role           OrgRole
  projectId      String?
  tokenHash      String               @unique
  invitedById    String
  approvalStatus InviteApprovalStatus @default(NONE)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime             @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invitedBy  User         @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  approvedBy User?        @relation("InviteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  acceptedBy User?        @relation("InviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([email])
}

model InviteAutoApproveRule {
  id          String   @id @default(cuid())
  orgId       String
  inviterId   String?
  createdById String
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter   User?        @relation("AutoApproveInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdBy User         @relation("AutoApproveCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  // Postgres does not enforce uniqueness among multiple NULLs in a unique
  // index, so this only dedupes per-inviter rules — the blanket
  // (inviterId: null) rule must be kept unique in application code by
  // deleting any existing blanket row before inserting a new one.
  @@unique([orgId, inviterId])
  @@index([orgId])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProjectAccessRequest {
  id            String              @id @default(cuid())
  orgId         String
  projectId     String
  requestedById String
  requestedRole OrgRole?
  status        AccessRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("ProjectAccessRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?        @relation("ProjectAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
}

model RoleChangeRequest {
  id            String              @id @default(cuid())
  orgId         String
  userId        String
  requestedRole OrgRole
  status        AccessRequestStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime            @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation("RoleChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?        @relation("RoleChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
}
