{
  "name": "envsync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Frontend",
    "Backend",
    "Cli"
  ],
  "scripts": {
    "dev": "npm run dev -w envsync-web",
    "build": "npm run build -w envsync-web",
    "start": "npm run start -w envsync-web",
    "lint": "npm run lint -w envsync-web",
    "dev:api": "npm run dev -w envsync-api",
    "build:api": "npm run build -w envsync-api",
    "start:api": "npm run start -w envsync-api",
    "dev:cli": "npm run dev -w @ashishlekhyani/envsync-cli",
    "build:cli": "npm run build -w @ashishlekhyani/envsync-cli"
  },
  "engines": {
    "node": ">=18"
  }
}
